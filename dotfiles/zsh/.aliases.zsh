alias ls='eza -lh --group-directories-first --icons=auto'
alias lsa='ls -a'
alias tree='eza --tree --level=2 --long --icons --git'

alias cat='bat -p'
alias grep='rg --color=auto'
alias vim='nvim'

alias reload="source ~/.zshrc"

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

alias c="clear"
alias x="exit"
